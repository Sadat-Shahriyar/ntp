{
    "paper_name": "RUN: Optimal Multiprocessor Real-Time Scheduling via Reduction to Uniprocessor",
    "paper_description": "Introduces RUN algorithm reducing multiprocessor scheduling to uniprocessor via DUAL and PACK operations, achieving optimality with O(log m) preemptions per job, outperforming prior optimal methods in overhead.",
    "results": [
        {
            "type": "definition",
            "identifier": "Definition II.1",
            "formal_description": {
                "statement": "Job J: finite instructions with release J.r, execution J.c, remaining e(J,t) = J.c - c(J,t).",
                "variables": {
                    "J": "job",
                    "r": "release",
                    "c": "execution requirement",
                    "e": "remaining at t"
                },
                "assumptions": ["Preemptable"],
                "conclusion": "Basic job model"
            },
            "informal_sketch": {
                "intuition": "Standard real-time job with timing params.",
                "steps": [
                    "Release at r",
                    "Needs c units by deadline"
                ],
                "pseudocode": "class Job:\n    def __init__(self, r, c):\n        self.r = r\n        self.c = c\n    def remaining(self, t):\n        return self.c - self.executed_up_to(t)",
                "key_insights": ["Foundation for tasks"]
            },
            "dependencies": []
        },
        {
            "type": "definition",
            "identifier": "Definition II.2",
            "formal_description": {
                "statement": "Fixed-Rate Task: rate mu <=1, jobs require mu*(d-r) execution, infinite sequence.",
                "variables": {
                    "mu": "rate",
                    "d": "deadline set"
                },
                "assumptions": ["Implicit deadlines"],
                "conclusion": "Generalizes periodic to fixed-rate"
            },
            "informal_sketch": {
                "intuition": "Constant density tasks.",
                "steps": [
                    "Each interval [r,d) demands mu*(d-r)"
                ],
                "pseudocode": "class FixedRateTask:\n    def __init__(self, mu):\n        self.mu = mu\n    def demand(self, r, d):\n        return self.mu * (d - r)",
                "key_insights": ["Equivalent to PPID"]
            },
            "dependencies": ["Definition II.1"]
        },
        {
            "type": "definition",
            "identifier": "Definition III.1",
            "formal_description": {
                "statement": "Server S for clients T with R(T) <=1: executes up to R(S)*(d_i+1 - d_i) in [d_i, d_i+1).",
                "variables": {
                    "S": "server",
                    "R": "rate",
                    "T": "client tasks"
                },
                "assumptions": ["R(S) >= R(T)"],
                "conclusion": "Server abstraction for scheduling"
            },
            "informal_sketch": {
                "intuition": "Virtual processor for task groups.",
                "steps": [
                    "Aggregate rates",
                    "Server gets bandwidth R(S)"
                ],
                "pseudocode": "class Server:\n    def __init__(self, R, clients):\n        self.R = R\n        self.clients = clients\n    def budget(self, d_i, d_next):\n        return self.R * (d_next - d_i)",
                "key_insights": ["Enables hierarchical scheduling"]
            },
            "dependencies": ["Definition II.2"]
        },
        {
            "type": "definition",
            "identifier": "Definition IV.1",
            "formal_description": {
                "statement": "Dual server S* of S: same deadlines, rate 1 - R(S).",
                "variables": {
                    "S*": "dual",
                    "R": "rate"
                },
                "assumptions": ["Unit deadlines"],
                "conclusion": "Complements execution with idle"
            },
            "informal_sketch": {
                "intuition": "S* runs when S idles.",
                "steps": [
                    "R(S*) = 1 - R(S)",
                    "Same d's"
                ],
                "pseudocode": "def dual_server(S):\n    return Server(1 - S.R, [])  # No clients",
                "key_insights": ["Enables reduction"]
            },
            "dependencies": ["Definition III.1"]
        },
        {
            "type": "theorem",
            "identifier": "Theorem IV.1",
            "formal_description": {
                "statement": "Schedule Sigma for Gamma valid iff dual Sigma* for Gamma* valid.",
                "variables": {
                    "Sigma": "schedule",
                    "Gamma": "server set",
                    "Gamma*": "dual set"
                },
                "assumptions": ["m processors"],
                "conclusion": "Duality preserves validity"
            },
            "informal_sketch": {
                "intuition": "Primal idle = dual work.",
                "steps": [
                    "Map executions inversely",
                    "Deadlines met iff dual met"
                ],
                "pseudocode": "def dual_validity(Sigma, Gamma, m):\n    Gamma_star = [dual(S) for S in Gamma]\n    Sigma_star = invert(Sigma)\n    return valid(Sigma, Gamma, m) == valid(Sigma_star, Gamma_star, m)",
                "key_insights": ["Core of reduction"]
            },
            "dependencies": ["Definition IV.1"]
        },
        {
            "type": "definition",
            "identifier": "Definition IV.3",
            "formal_description": {
                "statement": "Packing pi(Gamma): partition into subsets, each aggregated to ser(Gamma_i).",
                "variables": {
                    "pi": "packing",
                    "ser": "aggregate server"
                },
                "assumptions": ["Same deadlines"],
                "conclusion": "Reduces server count"
            },
            "informal_sketch": {
                "intuition": "Group compatible servers.",
                "steps": [
                    "Partition Gamma",
                    "Sum rates for each group"
                ],
                "pseudocode": "def packing(Gamma):\n    partitions = partition(Gamma, compatible)\n    return [Server(sum(p.R for p in part), []) for part in partitions]",
                "key_insights": ["Preserves total rate"]
            },
            "dependencies": ["Definition III.1"]
        },
        {
            "type": "theorem",
            "identifier": "Theorem IV.3",
            "formal_description": {
                "statement": "If proper set under reduction {psi_i}, then RUN schedule valid.",
                "variables": {
                    "RUN": "algorithm",
                    "psi": "reduction sequence"
                },
                "assumptions": ["Fixed-rate tasks"],
                "conclusion": "Correctness of RUN"
            },
            "informal_sketch": {
                "intuition": "Inductive validity from uniprocessor.",
                "steps": [
                    "Reduce to 1-processor EDF",
                    "Unpack duals and packs inductively"
                ],
                "pseudocode": "def run_schedule(T, m):\n    levels = reduce_sequence(T, m)\n    base = edf_schedule(levels[-1], 1)\n    for level in reversed(levels[:-1]):\n        unpack(base, level)\n    return base",
                "key_insights": ["Optimal via reduction"]
            },
            "dependencies": ["Theorem IV.1", "Definition IV.3"]
        },
        {
            "type": "theorem",
            "identifier": "Theorem V.1",
            "formal_description": {
                "statement": "RUN reduction complexity O(n log m) for n tasks, m procs.",
                "variables": {
                    "n": "tasks",
                    "m": "processors"
                },
                "assumptions": ["Packed sets"],
                "conclusion": "Efficient offline computation"
            },
            "informal_sketch": {
                "intuition": "Each reduce halves servers.",
                "steps": [
                    "Log levels from m to 1",
                    "Linear per level"
                ],
                "pseudocode": "def reduction_complexity(n, m):\n    return n * math.log2(m)",
                "key_insights": ["Log from packing"]
            },
            "dependencies": ["Theorem IV.3"]
        },
        {
            "type": "theorem",
            "identifier": "Theorem V.3",
            "formal_description": {
                "statement": "RUN average preemptions per job O(log m), <=3 in simulations.",
                "variables": {
                    "m": "processors"
                },
                "assumptions": ["RUN scheduled"],
                "conclusion": "Low runtime overhead"
            },
            "informal_sketch": {
                "intuition": "Preempts propagate log levels.",
                "steps": [
                    "Count per event type",
                    "Bound by tree depth"
                ],
                "pseudocode": "def preemptions_per_job(p):\n    return math.ceil((p + 1)/2)  # p reductions",
                "key_insights": ["Much lower than proportional fairness"]
            },
            "dependencies": ["Theorem V.1"]
        }
    ]
}