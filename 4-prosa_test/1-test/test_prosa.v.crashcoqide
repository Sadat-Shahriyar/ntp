From Coq Require Import List Arith.
From Prosa Require Import prosa.classic.model.task.

(* Open the default Prosa scope *)
Import List.ListNotations.

(* Define a simple periodic task *)
Definition my_task := {| task_cost := 5;
                         task_period := 20;
                         task_deadline := 20 |}.

Compute (task_cost my_task).
Compute (task_period my_task).
Compute (task_deadline my_task).
