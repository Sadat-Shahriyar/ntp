        "group_id": "G003"
      },
      "evidence_ids": [
        "E019",
        "E020",
        "E022",
        "E023"
      ],
      "status": "explicit",
      "notes": "Division by 1-U is undefined at U=1; the equation has no separate U=1 branch."
    },
    {
      "id": "N048",
      "type": "criterion",
      "concept": "bounded_demand_test_la_original",
