    {
      "id": "N115",
      "type": "proof_step",
      "concept": "improved_bound_floor_nonnegativity",
      "value": "When t>=max_i(D_i-T_i), each floor((t-D_i)/T_i) is at least -1, so the maximum in h(t) can be removed.",
      "expression": "t\\geq\\max_i\\{D_i-T_i\\}\\Rightarrow1+\\left\\lfloor\\frac{t-D_i}{T_i}\\right\\rfloor\\geq0",
      "label": null,
      "scope": {
