      },
      "evidence_ids": [
        "E098"
      ],
      "status": "explicit",
      "notes": null
    },
    {
      "id": "N117",
      "type": "proof_step",
      "concept": "improved_bound_overflow_horizon",
      "value": "From an overflow t<h(t), the upper estimate yields t(1-U)<sum_i(T_i-D_i)U_i and, for U<1, t<sum_i(T_i-D_i)U_i/(1-U).",
      "expression": "t(1-U)<\\sum_{i=1}^{n}(T_i-D_i)U_i\\ \\Rightarrow_{U<1}\\ t<\\frac{\\sum_{i=1}^{n}(T_i-D_i)U_i}{1-U}",
      "label": null,
      "scope": {
        "context_id": "N001",
        "group_id": "G019"
      },
      "evidence_ids": [
        "E099",
        "E100"
      ],
      "status": "explicit",
      "notes": "The paper says U<=1 at E099 but divides by 1-U in E100; dividing requires U<1. This caveat is not a replacement of the source theorem."
    },
