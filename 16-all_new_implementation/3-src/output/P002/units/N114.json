        "group_id": "G019"
      },
      "evidence_ids": [
        "E097"
      ],
      "status": "explicit",
      "notes": null
    },
    {
      "id": "N116",
      "type": "proof_step",
      "concept": "improved_bound_demand_upper_estimate",
      "value": "With the floor terms nonnegative, the proof upper bounds h(t) by t sum C_i/T_i plus sum (T_i-D_i)C_i/T_i.",
      "expression": "h(t)\\leq t\\sum_{i=1}^{n}\\frac{C_i}{T_i}+\\sum_{i=1}^{n}\\frac{C_i}{T_i}(T_i-D_i)",
      "label": null,
      "scope": {
